# Build artifacts - all regenerable with `make` / `make alsa`
dev/sbagen-fixed
dev/sbagen-asan
dev/sbagen-built
dev/sbagen
dev/*.o

# Generated audio - regenerate with ./mksounds.sh
out/

# Note: sbagen-1.4.5/ is intentionally NOT ignored.  That tree is kept as the
# pristine upstream reference, including its prebuilt binaries:
#   sbagen-1.4.5/sbagen-built  - the regression oracle. tests/run.sh and
#                                `make test` compare our output against it, and
#                                verify the defect tests actually fail on it.
# Keeping it in version control is what makes those checks reproducible.
# 64-bit codec archives built by tests/build-codecs.sh.  Large, and every
# platform rebuilds its own.  The Makefile skips mixing if they are absent.
dev/libs/linux-libmad64.a
dev/libs/linux-libogg64.a
dev/libs/linux-libvorbisidec64.a
dev/libsbagen.a
dev/sbagen-lib.o
tests/unit_render
